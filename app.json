{
  "expo": {
    "name": "VietinBank iPay",
    "slug": "vietinbank-ipay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vietinbank.ipay.notify",
      "infoPlist": {
        "CFBundleDisplayName": "VietinBank iPay",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#002a62",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.vietinbank.ipay.notify"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ed1c24"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "46a42565-f803-4486-b41d-226473962c86"
      }
    },
    "owner": "vinhmc9999"
  }
}
